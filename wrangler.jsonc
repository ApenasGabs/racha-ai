{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "racha-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "racha-ai.apenasgabs.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_RELAY",
        "class_name": "RoomRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomRelay"]
    }
  ]
}
